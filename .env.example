# ── THE VISUAL ARCHIVE — environment template ────────────────────────────────
# Frontend (Vite, exposed to the browser — only put PUBLIC values here)
# Supabase publishable (anon) key is a public client credential by design.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Backend (server-side only — NEVER prefix with VITE_)
PORT=4000
DATABASE_PATH=./database/visual-archive.db
# Optional: Openverse consumer token for higher rate limits on the search proxy
OPENVERSE_TOKEN=

# Legacy names still read by frontend/src/services/auth.js if present:
# SUPABASE_URL / SUPABASE_ANON_KEY
